# 数据库配置
POSTGRES_USER=ielts
POSTGRES_PASSWORD=ielts_password
POSTGRES_DB=ielts_db
PGDATA=/var/lib/postgresql/data/pgdata
DATABASE_URL=postgresql://ielts:ielts_password@postgres:5432/ielts_db

# 后端配置
SECRET_KEY=your-secret-key-change-in-production
BACKEND_PORT=8000
DEBUG=false

# 前端配置
FRONTEND_PORT=8080
NODE_ENV=production
VITE_API_URL=http://localhost:8080/api

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS 配置
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# 日志级别
LOG_LEVEL=info
